{
  "name": "@aievo/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/generated/schema.ts",
    "check": "openapi-typescript ../../apps/api/openapi.json -o src/generated/schema.ts --check || (echo Client is stale: run pnpm api-client:generate && exit 1)",
    "build": "pnpm run check && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
