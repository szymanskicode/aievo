# Copy this file to .env and fill in the values. .env is never committed.

# PostgreSQL connection used by the API and by migrations.
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://aievo:aievo@127.0.0.1:5432/aievo

# Separate database for integration tests. It is wiped by the test suite,
# so it must never point at the development database.
DATABASE_URL_TEST=postgresql://aievo:aievo@127.0.0.1:5432/aievo_test

# Database of the end-to-end tests (`pnpm test:e2e`), also wiped on every run.
# Optional: this is the default. Created automatically if it does not exist.
# DATABASE_URL_E2E=postgresql://aievo:aievo@127.0.0.1:5432/aievo_e2e_test

# Port of the API server. It always binds to 127.0.0.1.
API_PORT=3001

# pino log level of the API and the worker: fatal, error, warn, info, debug, trace or silent.
# Optional: info is the default.
# LOG_LEVEL=info

# Master key used to encrypt provider API keys and tokens (AES-256-GCM).
# 32 random bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored credential unreadable.
AIEVO_MASTER_KEY=

# --- Worker (runs of tasks) -------------------------------------------------
# All optional; the values below are the defaults.

# Data directory: runs clone into <AIEVO_WORKDIR>/runs/<run id>, removed after the run.
# Default: %LOCALAPPDATA%ievo on Windows, $XDG_DATA_HOME/aievo or ~/.local/share/aievo elsewhere.
# AIEVO_WORKDIR=

# Sandbox image, built with `pnpm sandbox:build`.
# AIEVO_SANDBOX_IMAGE=aievo-sandbox-node:1

# Limits of one sandbox container.
# AIEVO_SANDBOX_MEMORY_MB=4096
# AIEVO_SANDBOX_CPUS=2
# AIEVO_SANDBOX_PIDS=512

# uid:gid the sandbox runs as (never 0). Default: the host user on Linux/macOS,
# 1000:1000 on Windows.
# AIEVO_SANDBOX_USER=

# Longest run and longest single command (install, tests), in minutes.
# AIEVO_RUN_MAX_MINUTES=60
# AIEVO_COMMAND_TIMEOUT_MINUTES=15

# Active runs per project; further runs wait in the queue.
# AIEVO_MAX_RUNS_PER_PROJECT=1

# Runs one worker process executes at the same time (across projects).
# AIEVO_WORKER_CONCURRENCY=2

# Address of the web app; pull requests link to the run at <AIEVO_WEB_URL>/runs/<run id>.
# AIEVO_WEB_URL=http://127.0.0.1:5173

# E-mail of the commits agents make. The author name is the agent's, e.g. "AIEvo Programista".
# AIEVO_GIT_AUTHOR_EMAIL=agent@aievo.local
