{
  "name": "aievo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted platform where configurable AI agents deliver tasks as pull requests",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "turbo run test:e2e",
    "test:templates": "turbo run test:templates",
    "db:generate": "pnpm --filter @aievo/db db:generate",
    "db:migrate": "pnpm --filter @aievo/db db:migrate",
    "db:seed": "pnpm --filter @aievo/db db:seed",
    "openapi:generate": "pnpm --filter @aievo/api openapi:generate",
    "api-client:generate": "pnpm --filter @aievo/api-client generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
