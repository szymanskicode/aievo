{
  "name": "@aievo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@aievo/shared": "workspace:*",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
