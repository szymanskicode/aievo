{
  "name": "@aievo/presets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "agents",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src *.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:templates": "vitest run --config vitest.templates.config.ts"
  },
  "dependencies": {
    "@aievo/shared": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
