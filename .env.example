# Copy this file to .env and fill in the values. .env is never committed.

# PostgreSQL connection used by the API and by migrations.
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://aievo:aievo@127.0.0.1:5432/aievo

# Separate database for integration tests. It is wiped by the test suite,
# so it must never point at the development database.
DATABASE_URL_TEST=postgresql://aievo:aievo@127.0.0.1:5432/aievo_test

# Database of the end-to-end tests (`pnpm test:e2e`), also wiped on every run.
# Optional: this is the default. Created automatically if it does not exist.
# DATABASE_URL_E2E=postgresql://aievo:aievo@127.0.0.1:5432/aievo_e2e_test

# Port of the API server. It always binds to 127.0.0.1.
API_PORT=3001

# pino log level of the API: fatal, error, warn, info, debug, trace or silent.
# Optional: info is the default.
# LOG_LEVEL=info

# Master key used to encrypt provider API keys and tokens (AES-256-GCM).
# 32 random bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored credential unreadable.
AIEVO_MASTER_KEY=
